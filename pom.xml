<?xml version="1.0" encoding="UTF-8"?>
<!--
  AI 发布门禁平台（ai-release-gate）
  ★ 为什么是 Maven 多模块而不是一个大 module 里塞多个 main：
    这个项目的**卖点就是服务边界**（配置 / 发布 / 门禁各自独立的库与进程）。
    模块 = 边界，写在 pom 里比写在注释里可信。
  ★ 为什么没有 spring-cloud-*：
    一台机器 4 个进程，注册中心/配置中心/网关都是负收益（见 docs/设计.md §取舍）。
    服务发现用 docker compose 的服务名，网关用 nginx。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.arg</groupId>
  <artifactId>ai-release-gate</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>AI 发布门禁平台</name>

  <modules>
    <module>common</module>
    <module>config-svc</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
</project>
